# ========================================================
# Проект «Моя сказка» — Конфигурация переменных окружения
# ========================================================

# Окружение (development | test | production)
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# --------------------------------------------------------
# 1. База данных PostgreSQL (строгие транзакции и блокировки строк)
# --------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moya_skazka?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# --------------------------------------------------------
# 2. Telegram Bot & WebApp безопасность
# --------------------------------------------------------
# Токен бота от @BotFather (используется для HMAC-SHA256 валидации initData)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRstuVWXyz
# Username бота (например, MoyaSkazkaBot) для генерации ссылок startapp
TELEGRAM_BOT_USERNAME=MoyaSkazkaBot
# Секрет для выпуска внутренних JWT токенов сессии
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long
JWT_EXPIRES_IN=7d

# --------------------------------------------------------
# 3. Telegram Stars — Платежи
# --------------------------------------------------------
# Тестовые ориентиры цен (Stars)
STARS_PRICE_SINGLE_BOOK=400
STARS_PRICE_PACK_5=1600
RUB_REF_SINGLE_BOOK=199.00
RUB_REF_PACK_5=799.00
# Секретный токен для верификации вебхука Telegram
TELEGRAM_WEBHOOK_SECRET=telegram-webhook-secret-token

# --------------------------------------------------------
# 4. AI-провайдеры (Текст и Иллюстрации)
# --------------------------------------------------------
# Режимы текстовых провайдеров: wellflow | gemini | mock | openai
AI_TEXT_PROVIDER=wellflow
# Режимы генерации картинок: wellflow | gemini | mock | dalle3
AI_IMAGE_PROVIDER=wellflow

# Wellflow API (gemini-3.8-flash для текста; gpt-5.6-luna — более медленная альтернатива; Nano-Banana-2 для иллюстраций)
WELLFLOW_API_URL=https://api.wellflow.dev/v1
WELLFLOW_TEXT_KEY=your-wellflow-text-key-placeholder
WELLFLOW_TEXT_MODEL=gemini-3.8-flash
WELLFLOW_IMAGE_KEY=your-wellflow-image-key-placeholder
WELLFLOW_IMAGE_MODEL=nano-banana-2

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-placeholder

# Лимиты и таймауты AI
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=60000

# --------------------------------------------------------
# 5. Приватное хранилище ассетов (S3-compatible / MinIO / Supabase)
# --------------------------------------------------------
STORAGE_DRIVER=local # local | s3 | supabase
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=moya-skazka-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_SIGNED_URL_EXPIRES_SECONDS=3600

# --------------------------------------------------------
# 6. Воркер фоновых задач
# --------------------------------------------------------
# Тип воркера: db (встроенный воркер по таблице jobs с FOR UPDATE SKIP LOCKED) | bullmq
JOB_WORKER_TYPE=db
# Если используется Redis для BullMQ:
REDIS_URL=redis://localhost:6379
JOB_CONCURRENCY=5
JOB_POLL_INTERVAL_MS=3000

# --------------------------------------------------------
# 7. Фиче-флаги
# --------------------------------------------------------
# Аудио исключено из MVP по Разделу 2 ТЗ
ENABLE_AUDIO_MVP=false
# Режим отладки админки
ENABLE_ADMIN_DEV_LOGIN=true
ADMIN_SECRET_KEY=admin-secret-access-token-change-in-production
