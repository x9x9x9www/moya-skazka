# Copy to repository root as .env.vps, then fill all real values.
APP_DOMAIN=stories.example.com

# Never commit or log real provider credentials.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
WELLFLOW_TEXT_KEY=replace-with-text-provider-key
WELLFLOW_IMAGE_KEY=replace-with-image-provider-key

# Keep mock generation enabled until a separately approved live test.
AI_MOCK_MODE=true

# Optional provider/model overrides read by bot/bot.mjs.
WELLFLOW_TEXT_MODEL=
WELLFLOW_IMAGE_MODEL=
