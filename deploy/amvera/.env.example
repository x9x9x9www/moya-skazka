# Set in Amvera's protected environment settings; this file contains no secrets.
NODE_ENV=production
PORT=4040
SKIP_TUNNELS=true
DISABLE_PROXY=true
AI_MOCK_MODE=true

# Use the Amvera app's HTTPS URL without a trailing slash.
PUBLIC_BRIDGE_URL=https://your-bridge.amvera.app
# The Mini App stays on GitHub Pages for this first migration step.
WEB_APP_URL=https://x9x9x9www.github.io/moya-skazka/?v=4.4
CORS_ALLOWED_ORIGINS=https://x9x9x9www.github.io

# Persistent Amvera mount; keep both database and generated media under /data.
BOT_DATA_DIR=/data
BOT_DB_FILE=/data/db.json
BOT_GENERATED_DIR=/data/generated

# Add TELEGRAM_BOT_TOKEN and provider keys only in Amvera's secret settings.
# Do not enable live provider generation before separately approving a smoke test.
