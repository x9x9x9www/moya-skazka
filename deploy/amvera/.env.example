# ========================================================
# Переменные окружения для Amvera (Вкладка «Переменные» в панели)
# ========================================================

# 1. Системные настройки контейнера
NODE_ENV=production
PORT=4040
SKIP_TUNNELS=true
DISABLE_PROXY=true

# 2. Домен приложения на Amvera (без завершающего слэша)
# Пример: https://moya-skazka-bridge.amvera.io
PUBLIC_BRIDGE_URL=https://your-app-domain.amvera.io

# 3. Настройки Mini App (GitHub Pages) и CORS
WEB_APP_URL=https://x9x9x9www.github.io/moya-skazka/?v=4.4
CORS_ALLOWED_ORIGINS=https://x9x9x9www.github.io

# 4. Постоянное хранилище Amvera (сохранение между перезапусками)
BOT_DATA_DIR=/data
BOT_DB_FILE=/data/db.json
BOT_GENERATED_DIR=/data/generated

# 5. Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username

# 6. Нейросети — ВКЛЮЧЕНЫ (LIVE режим, НЕ MOCK)
AI_MOCK_MODE=false
AI_TEXT_PROVIDER=wellflow
AI_IMAGE_PROVIDER=wellflow

# Ключи и модели Wellflow API (или совместимого OpenAI / OpenRouter)
WELLFLOW_API_URL=https://api.wellflow.dev/v1
WELLFLOW_TEXT_KEY=your-wellflow-text-key
WELLFLOW_TEXT_MODEL=gpt-6-luna
WELLFLOW_IMAGE_KEY=your-wellflow-image-key
WELLFLOW_IMAGE_MODEL=nano-banana-2
